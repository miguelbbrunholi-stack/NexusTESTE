{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd NexusFinance && npm ci",
  "buildCommand": "cd NexusFinance && npx expo export --platform web",
  "outputDirectory": "NexusFinance/dist",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.git/**,backend/.venv/**,NexusFinance/node_modules/**,NexusFinance/dist/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
